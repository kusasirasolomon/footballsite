rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if false;
    }

    match /standings/{standingId} {
      allow read: if true;
      allow write: if false;
    }

    match /trending/{trendId} {
      allow read: if true;
      allow write: if false;
    }

    match /apiCache/{cacheKey} {
      allow read: if false;
      allow write: if false;
    }

    match /rateLimits/{fingerprint} {
      allow read, write: if false;
    }
  }
}
